rules_version = '2';
// Facilities Project Tracker. Only the facilities manager changes projects;
// people on the access list (contacts with an email) can read, register themselves and ask questions.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && email() == 'csiemonsma@harvardintegrations.com'; }
    function invited() { return signedIn() && exists(/databases/$(database)/documents/access/$(email())); }
    function allowed() { return isOwner() || invited(); }

    // project requests are for the owner's eyes only; everything else is readable by people on the list
    match /{coll}/{rest=**} {
      allow read: if isOwner() || (invited() && !(coll in ['requests', 'knock', 'notes', 'voice', 'occTeam', 'occItems', 'occMsgs', 'occMeta', 'occKnock', 'occDocs', 'occSignoffs']));
      allow write: if isOwner();
    }
    // anyone can send a project request from the public request page, without an account
    function text(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function validRequest(d) {
      return d.keys().hasOnly(['name','email','phone','department','title','type','location','description','priority','neededBy','budget','status','at','via','by'])
        && d.keys().hasAll(['name','title','description','status','at'])
        && d.status == 'new' && d.name.size() > 0 && d.title.size() > 0 && d.description.size() > 0
        && text(d,'name',100) && text(d,'email',200) && text(d,'phone',40) && text(d,'department',100)
        && text(d,'title',150) && text(d,'type',20) && text(d,'location',150) && text(d,'description',4000)
        && text(d,'priority',10) && text(d,'neededBy',10) && text(d,'budget',60) && text(d,'at',40) && text(d,'via',10)
        && (!('by' in d) || (request.auth != null && d.by == request.auth.uid));
    }
    // someone who signed in but isn't on the list leaves their name so the owner sees them (once; only the owner reads or clears it)
    match /knock/{addr} {
      allow create: if signedIn() && addr == email()
        && request.resource.data.keys().hasOnly(['email','name','uid','at'])
        && request.resource.data.email == email() && request.resource.data.uid == request.auth.uid
        && text(request.resource.data,'name',100) && text(request.resource.data,'at',40);
    }
    match /requests/{rid} {
      allow create: if validRequest(request.resource.data);
    }
    // operators send voice reports from the unlisted /voice/ page, without an account; only the owner reads them
    function validVoice(d) {
      return d.keys().hasOnly(['name','building','machine','note','audio','type','size','secs','status','at','via'])
        && d.keys().hasAll(['name','status','at'])
        && d.status == 'new' && d.name is string && d.name.size() > 0
        && text(d,'name',100) && text(d,'building',100) && text(d,'machine',150) && text(d,'note',2000)
        && text(d,'type',60) && text(d,'at',40) && text(d,'via',10)
        && (!('audio' in d) || (d.audio is string && d.audio.matches('voice/[A-Za-z0-9_.-]{1,80}')))
        && (!('size' in d) || d.size is int) && (!('secs' in d) || d.secs is int)
        && ('audio' in d || ('note' in d && d.note.size() > 0));
    }
    match /voice/{vid} {
      allow create: if validVoice(request.resource.data);
    }
    // each person keeps their own profile (name, role, what they've read)
    match /people/{uid} {
      allow create, update: if allowed() && request.auth.uid == uid;
    }
    // anyone on the list can ask or answer a question; only the owner deletes
    match /questions/{qid} {
      allow create, update: if allowed();
    }
    // notes from people on a project: hidden from others until the owner approves them
    match /notes/{nid} {
      allow read: if isOwner() || (invited() && (resource.data.status == 'approved' || resource.data.author == request.auth.uid));
      allow create: if isOwner() || (invited()
        && request.resource.data.keys().hasOnly(['projectId','text','author','at','status'])
        && request.resource.data.author == request.auth.uid && request.resource.data.status == 'pending'
        && request.resource.data.projectId is string && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000 && text(request.resource.data,'at',40));
    }
    // New building Path to Occupancy: only the owner and people on occTeam read or write it
    function onOcc() { return isOwner() || (signedIn() && exists(/databases/$(database)/documents/occTeam/$(email()))); }
    // anyone on the team can add a new person (not change or remove an existing one) and turn their own phone alerts on or off
    match /occTeam/{addr} {
      allow read: if onOcc() || (signedIn() && addr == email());
      allow create: if onOcc() && addr.matches('[^@ /]+@[^@ /]+[.][^@ /]+') && addr == addr.lower()
        && request.resource.data.keys().hasOnly(['name','role','photo','addedAt','addedBy'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && text(request.resource.data,'name',100)
        && text(request.resource.data,'role',100) && text(request.resource.data,'addedAt',40) && text(request.resource.data,'addedBy',100)
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() < 300000 && request.resource.data.photo.matches('data:image/.*')));
      allow update: if onOcc() && addr == email() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ntfy'])
        && request.resource.data.ntfy is string && request.resource.data.ntfy.matches('([A-Za-z0-9_-]{16,64})?');
    }
    // anyone on the team can import a checklist file's details; only the owner changes the occupancy date or whether it's confirmed
    function sameMeta(k) { return (resource == null && !(k in request.resource.data)) || (resource != null && request.resource.data.get(k, null) == resource.data.get(k, null)); }
    function list(d, k, max) { return !(k in d) || (d[k] is list && d[k].size() <= max); }
    match /occMeta/{id} {
      allow read: if onOcc();
      allow create, update: if onOcc() && id == 'main'
        && request.resource.data.keys().hasOnly(['target','targetConfirmed','project','baseline','milestones','decisions','weeks','later'])
        && sameMeta('target') && sameMeta('targetConfirmed')
        && text(request.resource.data,'project',120) && text(request.resource.data,'baseline',80)
        && list(request.resource.data,'milestones',4) && list(request.resource.data,'decisions',6) && list(request.resource.data,'weeks',4) && list(request.resource.data,'later',10);
    }
    function validOccItem(d) {
      return d.keys().hasOnly(['title','cat','who','due','status','note','order','updatedAt','updatedBy','flag','short','tag'])
        && d.keys().hasAll(['title','status'])
        && d.title is string && d.title.size() > 0 && text(d,'title',200) && text(d,'cat',60) && text(d,'who',80)
        && text(d,'due',10) && d.status in ['Not started','In progress','Blocked','Done'] && text(d,'note',2000)
        && (!('order' in d) || d.order is number) && text(d,'updatedAt',40) && text(d,'updatedBy',100)
        && (!('flag' in d) || d.flag in ['', 'watch', 'confirm']) && text(d,'short',60) && text(d,'tag',60);
    }
    match /occItems/{id} {
      allow read: if onOcc();
      allow create, update: if onOcc() && validOccItem(request.resource.data);
    }
    function validOccMsg(d) {
      return d.keys().hasOnly(['text','kind','itemId','author','name','at'])
        && d.keys().hasAll(['text','kind','author','at'])
        && d.author == request.auth.uid && d.text is string && d.text.size() > 0 && d.text.size() <= 3000
        && d.kind in ['note','question','delay','change'] && text(d,'itemId',60) && text(d,'name',100) && text(d,'at',40);
    }
    match /occMsgs/{id} {
      allow read: if onOcc();
      allow create: if onOcc() && validOccMsg(request.resource.data);
      // anyone on the team can mark a question answered or a delay resolved, and nothing else
      allow update: if onOcc() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved','resolvedBy'])
        && (!('resolved' in request.resource.data) || request.resource.data.resolved is bool) && text(request.resource.data,'resolvedBy',100);
      allow delete: if onOcc() && resource.data.author == request.auth.uid;
    }
    // occupancy sign-offs (final inspections, acceptance tests, the CO): anyone on the team updates them, only the owner deletes
    function validSignoff(d) {
      return d.keys().hasOnly(['title','desc','party','status','date','ref','who','note','order','updatedAt','updatedBy'])
        && d.keys().hasAll(['title','status']) && d.title is string && d.title.size() > 0 && text(d,'title',120)
        && d.status in ['To verify','Scheduled','Corrections needed','Approved','Not applicable']
        && text(d,'desc',200) && text(d,'party',100) && text(d,'date',10) && text(d,'ref',80) && text(d,'who',100) && text(d,'note',1000)
        && (!('order' in d) || d.order is number) && text(d,'updatedAt',40) && text(d,'updatedBy',100);
    }
    match /occSignoffs/{id} {
      allow read: if onOcc();
      allow create, update: if onOcc() && validSignoff(request.resource.data);
    }
    // links and uploaded files the team shares (schedule, drawings, reports); anyone on the team adds one, the person who added it or the owner removes it
    match /occDocs/{id} {
      allow read: if onOcc();
      allow create: if onOcc() && request.resource.data.keys().hasOnly(['title','url','by','name','at','path','size','type'])
        && request.resource.data.keys().hasAll(['title','url','by','at']) && request.resource.data.by == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && text(request.resource.data,'title',120)
        && request.resource.data.url is string && request.resource.data.url.matches('https://.{1,990}')
        && text(request.resource.data,'name',100) && text(request.resource.data,'at',40)
        && (!('path' in request.resource.data) || (request.resource.data.path is string && request.resource.data.path.matches('occ/[A-Za-z0-9_-]{10,40}/.{1,200}')))
        && (!('size' in request.resource.data) || request.resource.data.size is number) && text(request.resource.data,'type',100);
      allow delete: if onOcc() && resource.data.by == request.auth.uid;
    }
    // someone signed in but not on the team leaves their email once so the owner can add them
    match /occKnock/{addr} {
      allow create: if signedIn() && addr == email()
        && request.resource.data.keys().hasOnly(['email','name','uid','at'])
        && request.resource.data.email == email() && request.resource.data.uid == request.auth.uid
        && text(request.resource.data,'name',100) && text(request.resource.data,'at',40);
    }
    // lets someone check whether their own email is on the list
    match /access/{addr} {
      allow get: if signedIn() && addr == email();
    }
  }
}
